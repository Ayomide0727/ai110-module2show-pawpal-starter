classDiagram
    %% PawPal+ initial design draft. Update this as the implementation evolves.

    class Owner {
        +str name
        +list~Pet~ pets
        +int available_minutes_per_day
        +add_pet(pet: Pet)
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task)
        +edit_task(task_id, changes)
    }

    class Task {
        +str id
        +str title
        +int duration_minutes
        +str priority
        +str pet_name
        +time start_time
        +str reason
    }

    class Scheduler {
        +list~Task~ scheduled_tasks
        +list~Task~ skipped_tasks
        +generate_plan(owner: Owner)
        +explain() str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler "1" --> "1" Owner : schedules for
    Scheduler "1" --> "*" Task : places
